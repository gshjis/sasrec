{
  "$schema": "https://opencode.ai/config.json",
  "plugins": ["@cortexkit/opencode-magic-context@latest"],
  "compaction": {
    "auto": false,
  },
  "mcp": {
    "servers": {
      "codebase-memory": {
        "type": "local",
        "command": [
          "/home/gshjis/.local/bin/codebase-memory-mcp"
        ]
      },
      "tinyfish": {
        "type": "remote",
        "url": "https://agent.tinyfish.ai/mcp"
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp"
      },
      "sequential-thinking": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@modelcontextprotocol/server-sequential-thinking"
        ]
      }
    }
  },
  "permissions": [
    {
      "action": "skill",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git push *",
      "effect": "ask"
    }
  ]
}
